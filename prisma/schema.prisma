generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String              @id @default(uuid())
  email                     String              @unique
  passwordHash              String
  name                      String?
  notificationEmail         String?
  emailNotificationsEnabled Boolean             @default(true)
  reminderDaysBefore        Int                 @default(1)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  jacuzzi                   Jacuzzi?
  chemicals                 ChemicalInventory[]
  waterLogs                 WaterLog[]
  tasks                     MaintenanceTask[]
  diaryEntries              DiaryEntry[]
}

model Jacuzzi {
  id                String   @id @default(uuid())
  userId            String   @unique
  name              String   @default("הג'קוזי שלי")
  brand             String?
  model             String?
  volumeLiters      Int      @default(1200)
  sanitizationType  String   @default("CHLORINE") // CHLORINE, BROMINE, SALT, ACTIVE_OXYGEN
  location          String   @default("OUTDOOR")  // OUTDOOR, INDOOR, ROOF
  usageFrequency    String   @default("MEDIUM")   // LIGHT, MEDIUM, HEAVY
  lastRefillDate    DateTime @default(now())
  lastDeepCleanDate DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChemicalInventory {
  id           String   @id @default(uuid())
  userId       String
  name         String
  category     String   @default("OTHER") // SANITIZER, PH_PLUS, PH_MINUS, SHOCK, CLARIFIER, ANTI_FOAM, ALGAECIDE, TEST_STRIPS, CLEANER, OTHER
  quantity     Float    @default(0)
  unit         String   @default("GRAMS") // GRAMS, ML, TABLETS, STRIPS, PIECES
  minThreshold Float    @default(100)
  imageUrl     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WaterLog {
  id                String   @id @default(uuid())
  userId            String
  testedAt          DateTime @default(now())
  ph                Float?
  freeChlorine      Float?
  alkalinity        Float?
  waterClarity      String   @default("CLEAR") // CLEAR, SLIGHTLY_CLOUDY, VERY_CLOUDY, GREEN, FOAMY, BAD_ODOR
  description       String?
  imageUrl          String?
  aiDiagnosis       String?
  aiRecommendations String?
  actionsTaken      String?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceTask {
  id            String    @id @default(uuid())
  userId        String
  title         String
  description   String?
  category      String    @default("WEEKLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY, CUSTOM
  frequencyDays Int       @default(7)
  lastDoneDate  DateTime?
  nextDueDate   DateTime
  isCompleted   Boolean   @default(false)
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id                 String   @id @default(uuid())
  userId             String
  entryDate          DateTime @default(now())
  title              String
  content            String
  chemicalsAdded     String?  // JSON or text of chemicals added
  waterQualityRating Int?     @default(5) // 1 to 5 stars
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

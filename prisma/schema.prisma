generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String              @id @default(uuid())
  email                     String              @unique
  passwordHash              String
  name                      String?
  notificationEmail         String?
  emailNotificationsEnabled Boolean             @default(true)
  reminderDaysBefore        Int                 @default(1)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  jacuzzi                   Jacuzzi?
  chemicals                 ChemicalInventory[]
  waterLogs                 WaterLog[]
  tasks                     MaintenanceTask[]
  diaryEntries              DiaryEntry[]
}

model Jacuzzi {
  id                String   @id @default(uuid())
  userId            String   @unique
  name              String   @default("הג'קוזי שלי")
  brand             String?
  model             String?
  volumeLiters      Int      @default(1200)
  sanitizationType  String   @default("CHLORINE") // CHLORINE, BROMINE, SALT, ACTIVE_OXYGEN
  location          String   @default("OUTDOOR")  // OUTDOOR, INDOOR, ROOF
  usageFrequency    String   @default("MEDIUM")   // LIGHT, MEDIUM, HEAVY
  lastRefillDate    DateTime @default(now())
  lastDeepCleanDate DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChemicalInventory {
  id               String   @id @default(uuid())
  userId           String
  name             String
  category         String   @default("OTHER") // SANITIZER, PH_MINUS, PH_PLUS, SHOCK, ANTI_FOAM, CLARIFIER, TEST_STRIPS, CLEANER, OTHER
  quantity         Float    @default(0)
  unit             String   @default("GRAMS") // GRAMS, ML, TABLETS, STRIPS, PIECES
  minThreshold     Float    @default(100)
  imageUrl         String?
  notes            String?
  addedDate        DateTime @default(now())
  lastUsedDate     DateTime?
  lastUsedAmount   Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WaterLog {
  id                String   @id @default(uuid())
  userId            String
  testedAt          DateTime @default(now())
  ph                Float?
  phRange           String?  // e.g. "7.2 - 7.6 (אידיאלי)"
  freeChlorine      Float?
  chlorineRange     String?  // e.g. "2.0 - 4.0 ppm (אידיאלי)"
  alkalinity        Float?
  alkalinityRange   String?  // e.g. "80 - 120 ppm (אידיאלי)"
  waterClarity      String   @default("CLEAR") // CLEAR, SLIGHTLY_CLOUDY, VERY_CLOUDY, GREEN, FOAMY, BAD_ODOR
  description       String?
  imageUrl          String?
  aiDiagnosis       String?
  aiRecommendations String?
  actionsTaken      String?
  valueBefore       String?  // e.g. "pH 7.9, כלור 0.5"
  valueAfter        String?  // e.g. "pH 7.4, כלור 3.5"
  amountAdded       String?  // e.g. "25 גרם pH Minus, 15 גרם כלור"
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MaintenanceTask {
  id                      String    @id @default(uuid())
  userId                  String
  title                   String
  description             String?
  category                String    @default("WEEKLY") // DAILY, WEEKLY, MONTHLY, QUARTERLY, CUSTOM
  frequencyDays           Int       @default(7)
  lastDoneDate            DateTime?
  nextDueDate             DateTime
  isCompleted             Boolean   @default(false)
  priority                String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  // Numerical / structured treatment logging fields
  lastValueBefore         String?
  lastValueAfter          String?
  lastAmountAdded         String?
  lastChemicalUsed        String?
  lastChemicalInventoryId String?
  lastDeductAmount        Float?
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id                 String   @id @default(uuid())
  userId             String
  entryDate          DateTime @default(now())
  title              String
  content            String
  chemicalsAdded     String?  // JSON or text
  valueBefore        String?
  valueAfter         String?
  waterQualityRating Int?     @default(5) // 1 to 5 stars
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
